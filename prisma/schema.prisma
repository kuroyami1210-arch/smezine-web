// Prisma schema — port dari 4 migration Laravel:
// beritas, galeris, anggotas, tentang_slide1s (+ users untuk mirror admin Supabase Auth)

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String?
  email     String   @unique
  createdAt DateTime @default(now())

  // Password TIDAK disimpan di sini saat pakai Supabase Auth.
  // Kolom ini hanya untuk kompatibilitas / fallback credentials.
  passwordHash String?
}

model Berita {
  id        Int      @id @default(autoincrement())
  judul     String   @db.VarChar(255)
  deskripsi String   @db.Text
  gambarKey String   @db.VarChar(512)
  gambarUrl String   @db.VarChar(1024)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model Galeri {
  id        Int      @id @default(autoincrement())
  judul     String   @db.VarChar(255)
  deskripsi String?  @db.Text
  gambarKey String   @db.VarChar(512)
  gambarUrl String   @db.VarChar(1024)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
}

model Anggota {
  id        Int      @id @default(autoincrement())
  nama      String   @db.VarChar(255)
  jabatan   String   @db.VarChar(255)
  kategori  String   @default("pengurus") @db.VarChar(50)
  fotoKey   String?  @db.VarChar(512)
  fotoUrl   String?  @db.VarChar(1024)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([urutan, createdAt])
}

model TentangSlide1 {
  id        Int      @id @default(autoincrement())
  judul     String?  @db.VarChar(255)
  deskripsi String?  @db.Text
  fotoKey   String?  @db.VarChar(512)
  fotoUrl   String?  @db.VarChar(1024)
  updatedAt DateTime @updatedAt
}
